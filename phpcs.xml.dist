<?xml version="1.0"?>
<ruleset name="Ghoroa Hat Rewards">
  <description>WordPress Core coding rules, with individually documented static SQL-fragment exceptions.</description>
  <file>ghoroa-hat-rewards.php</file>
  <file>uninstall.php</file>
  <file>src</file>
  <arg name="extensions" value="php"/>
  <rule ref="WordPress-Core"/>
</ruleset>
